---
// Review card styled after the source platform: avatar initials, stars, treatment and date.
import { initials, type Review } from '../data/reviews';

interface Props {
	review: Review;
	tone?: 'white' | 'dark' | 'soft';
	/** Shows the headline in large type. */
	featured?: boolean;
}

const { review, tone = 'white', featured = false } = Astro.props;
const stars = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);
---

<figure class:list={['review', tone, { featured }]} data-treatment={review.treatment}>
	<div class="top">
		<span class="stars" role="img" aria-label={`Rated ${review.rating} out of 5`}>{stars}</span>
		<span class="source">
			{
				review.source === 'Google' ? (
					<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24">
						<path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.2 3.5-8.8z" />
						<path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.9-3c-1 .7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9h-4v3.1A12 12 0 0 0 12 24z" />
						<path fill="#FBBC05" d="M5.4 14.4a7.2 7.2 0 0 1 0-4.7V6.6h-4a12 12 0 0 0 0 10.9l4-3.1z" />
						<path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.4 6.6l4 3.1C6.3 6.9 8.9 4.8 12 4.8z" />
					</svg>
				) : (
					<span aria-hidden="true" class="source-dot" />
				)
			}
			{review.source}
		</span>
	</div>
	{featured && review.headline && <p class="headline">“{review.headline}”</p>}
	<blockquote>{featured && review.headline ? review.quote : `“${review.quote}”`}</blockquote>
	<figcaption>
		<span aria-hidden="true" class="avatar">{initials(review.name)}</span>
		<span class="who">
			<strong>{review.name}</strong>
			<span class="meta">{review.treatment} · {review.date}{review.visits && ` · ${review.visits}`}</span>
		</span>
	</figcaption>
</figure>

<style>
	.review {
		padding: 28px;
		border-radius: 20px;
		display: flex;
		flex-direction: column;
		gap: 18px;
		--quote: var(--body-2);
		--meta: var(--muted);
		--avatar-bg: var(--tint);
		--avatar-text: var(--accent);
		--chip: var(--bg);
		--star-color: var(--star);
	}
	.white {
		background: var(--white);
		border: 1px solid var(--line-2);
	}
	.soft {
		background: var(--soft);
		--chip: var(--white);
	}
	.dark {
		background: var(--dark);
		color: var(--white);
		--quote: var(--on-dark);
		--meta: var(--on-dark-2);
		--avatar-bg: var(--dark-card);
		--avatar-text: var(--accent-light);
		--chip: var(--dark-card);
		--star-color: var(--star-light);
	}
	.featured {
		padding: clamp(28px, 3vw, 40px);
		gap: 20px;
	}
	.top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
	}
	.stars {
		color: var(--star-color);
		letter-spacing: 3px;
		font-size: 15px;
	}
	.source {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--chip);
		color: var(--meta);
		font-size: 12px;
		font-weight: 600;
	}
	.source-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #19b4a5;
	}
	.headline {
		font-family: var(--font-display);
		font-size: clamp(20px, 2vw, 24px);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}
	blockquote {
		color: var(--quote);
		font-size: 15px;
		line-height: 1.7;
	}
	figcaption {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: auto;
		padding-top: 4px;
	}
	.avatar {
		flex: none;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: var(--avatar-bg);
		color: var(--avatar-text);
		font-weight: 600;
		font-size: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.who {
		display: flex;
		flex-direction: column;
		line-height: 1.35;
		font-size: 15px;
	}
	.meta {
		font-size: 13px;
		color: var(--meta);
	}
</style>
