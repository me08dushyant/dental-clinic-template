---
// Photo card linking to a treatment's detail page.
import Icon from './Icon.astro';
import { treatmentHref } from '../data/site';
import type { Treatment } from '../data/treatments';

interface Props {
	treatment: Treatment;
	headingLevel?: 'h3' | 'h2';
}

const { treatment: t, headingLevel: Heading = 'h3' } = Astro.props;
const price = t.facts.find((f) => f.label === 'From')?.value;
---

<a href={treatmentHref(t.slug)} class="tcard">
	<span class="tcard-media">
		<img src={t.photo.src} alt="" loading="lazy" decoding="async" style={{ objectPosition: t.photoPosition }} />
		<span class="tcard-cat">{t.category}</span>
	</span>
	<span class="tcard-body">
		<Heading class="tcard-title">{t.name}</Heading>
		<span class="tcard-text">{t.summary}</span>
		<span class="tcard-foot">
			{price && <span class="tcard-price">From {price}</span>}
			<span class="tcard-more">Learn more<Icon name="arrow" size={15} strokeWidth={2} /></span>
		</span>
	</span>
</a>

<style>
	.tcard {
		display: flex;
		flex-direction: column;
		border-radius: 22px;
		overflow: hidden;
		background: var(--white);
		border: 1px solid var(--line-2);
		color: var(--ink);
		text-decoration: none;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.tcard:hover {
		color: var(--ink);
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}
	.tcard-media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--photo);
	}
	.tcard-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.tcard:hover .tcard-media img {
		transform: scale(1.05);
	}
	.tcard-cat {
		position: absolute;
		left: 14px;
		top: 14px;
		padding: 4px 12px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.tcard-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 22px 24px 24px;
	}
	.tcard-title {
		font-size: 20px;
		font-weight: 500;
		letter-spacing: -0.015em;
	}
	.tcard-text {
		font-size: 15px;
		color: var(--muted);
	}
	.tcard-foot {
		margin-top: auto;
		padding-top: 12px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		font-size: 14px;
	}
	.tcard-price {
		color: var(--body-2);
		font-weight: 500;
	}
	.tcard-more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--accent);
		font-weight: 600;
	}
</style>
