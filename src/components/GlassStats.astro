---
// Frosted stats strip that sits on the bottom-right edge of a photo hero.
interface Props {
	items: { value: string; label: string }[];
	maxWidth?: string;
	size?: 'lg' | 'md';
}

const { items, maxWidth = '900px', size = 'lg' } = Astro.props;
---

<div class="wrap">
	<dl class:list={['stats', `stats--${size}`]} style={{ flexBasis: maxWidth }}>
		{
			items.map((item) => (
				<div>
					<dt>{item.label}</dt>
					<dd data-count>{item.value}</dd>
				</div>
			))
		}
	</dl>
</div>

<script>
	// Count the numeric part of each stat up from zero when the strip comes into view,
	// keeping whatever surrounds it ("[", "+", "★", "h") and its formatting (commas, decimals).
	const stats = document.querySelectorAll<HTMLElement>('[data-count]');
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const countUp = (el: HTMLElement) => {
		const text = el.textContent ?? '';
		const match = text.match(/\d[\d,]*(\.\d+)?/);
		if (!match) return;
		const target = Number(match[0].replace(/,/g, ''));
		const decimals = match[1] ? match[1].length - 1 : 0;
		const format = (n: number) =>
			match[0].includes(',') ? n.toLocaleString('en-IN', { maximumFractionDigits: decimals }) : n.toFixed(decimals);
		const [before, after] = [text.slice(0, match.index), text.slice(match.index! + match[0].length)];
		const start = performance.now();
		const duration = 1600;

		const tick = (now: number) => {
			const t = Math.min((now - start) / duration, 1);
			const eased = 1 - Math.pow(1 - t, 3);
			el.textContent = before + format(target * eased) + after;
			if (t < 1) requestAnimationFrame(tick);
			else el.textContent = text;
		};
		requestAnimationFrame(tick);
	};

	if (!reduced && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				countUp(entry.target as HTMLElement);
				observer.unobserve(entry.target);
			}
		});
		stats.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.wrap {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: flex-end;
	}
	.stats {
		flex: 0 1 900px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		background: rgba(255, 255, 255, 0.14);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-top: 1px solid rgba(255, 255, 255, 0.45);
		border-left: 1px solid rgba(255, 255, 255, 0.45);
		border-radius: 18px 0 0 0;
		color: var(--white);
	}
	.stats > div {
		padding: 28px 20px;
		text-align: center;
		display: flex;
		flex-direction: column-reverse;
	}
	.stats--md > div {
		padding-block: 26px;
	}
	dt {
		font-size: 13px;
		color: var(--on-dark);
	}
	dd {
		font-size: 44px;
		font-weight: 700;
		line-height: 1.1;
		/* Steady width while the numbers count up */
		font-variant-numeric: tabular-nums;
	}
	.stats--md dd {
		font-size: 40px;
	}
	@media (max-width: 560px) {
		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		dd,
		.stats--md dd {
			font-size: 32px;
		}
	}
</style>
