---
import Icon from './Icon.astro';
import { routes, site, treatmentHref } from '../data/site';
import { dentist } from '../data/dentist';
---

<footer class="footer">
	<div class="container inner">
		<div class="cols">
			<div class="col col--brand">
				<span class="brand"><Icon name="tooth" size={24} strokeWidth={1.7} />{site.name}</span>
				<span>{site.tagline} in {site.area}, {site.city}. Led by {dentist.name}.</span>
				<span class="rating"><span aria-hidden="true" class="stars">★★★★★</span>{site.rating.value} from {site.rating.count} Google reviews</span>
			</div>
			<nav aria-label="Clinic" class="col">
				<span class="heading">Clinic</span>
				<a href={routes.about}>About</a>
				<a href={routes.services}>All treatments</a>
				<a href={routes.dentist}>Our dentist</a>
				<a href={routes.reviews}>Reviews</a>
				<a href={routes.contact}>Contact</a>
			</nav>
			<nav aria-label="Treatments" class="col">
				<span class="heading">Treatments</span>
				<a href={treatmentHref('check-up-and-cleaning')}>Check-up &amp; cleaning</a>
				<a href={treatmentHref('root-canal-treatment')}>Root canal treatment</a>
				<a href={treatmentHref('dental-implants')}>Dental implants</a>
				<a href={treatmentHref('clear-aligners')}>Braces &amp; aligners</a>
				<a href={treatmentHref('teeth-whitening')}>Teeth whitening</a>
				<a href={treatmentHref('veneers')}>Veneers &amp; smile design</a>
			</nav>
			<div class="col">
				<span class="heading">Contact</span>
				<span>{site.street},<br />{site.area}, {site.city} {site.postalCode}</span>
				<a href={site.phoneHref} class="phone">{site.phoneDisplay}</a>
				<a href={site.whatsapp}>WhatsApp us</a>
				<a href={site.emailHref}>{site.email}</a>
				<span>{site.hoursShort}</span>
			</div>
		</div>
		<div class="legal">
			<span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
			<span>{site.registration}</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--footer);
		color: var(--footer-text);
		font-size: 15px;
	}
	.inner {
		padding-block: 72px 32px;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}
	.cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 32px;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.col--brand {
		gap: 12px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--white);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 18px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.brand :global(svg) {
		color: var(--accent-light);
	}
	.rating {
		display: flex;
		flex-direction: column;
		font-size: 14px;
	}
	.stars {
		color: var(--star-light);
	}
	.heading {
		margin-bottom: 6px;
		color: var(--accent-light);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.col a {
		color: var(--footer-text);
		text-decoration: none;
	}
	.col a:hover,
	.col a.phone {
		color: var(--white);
	}
	.legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px;
		padding-top: 24px;
		border-top: 1px solid var(--footer-line);
		font-size: 14px;
	}
</style>
