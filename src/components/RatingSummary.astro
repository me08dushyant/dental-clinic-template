---
// Aggregate rating with a star breakdown, the way review platforms show it.
import { site } from '../data/site';
import { ratingBreakdown } from '../data/reviews';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['summary', className]}>
	<div class="score">
		<span class="value">{site.rating.value}</span>
		<span class="stars" aria-hidden="true">★★★★★</span>
		<span class="count">{site.rating.count} reviews on {site.rating.source}</span>
	</div>
	<dl class="bars">
		{
			ratingBreakdown.map((row) => (
				<div class="bar-row">
					<dt>{row.stars}★</dt>
					<dd>
						<span class="track"><span class="fill" style={{ width: `${row.share}%` }} /></span>
						<span class="share">{row.share}%</span>
					</dd>
				</div>
			))
		}
	</dl>
</div>

<style>
	.summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px 40px;
		padding: clamp(24px, 3vw, 36px);
		border-radius: 24px;
		background: var(--white);
		border: 1px solid var(--line-2);
	}
	.score {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.value {
		font-family: var(--font-display);
		font-size: 64px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.stars {
		color: var(--star);
		letter-spacing: 3px;
	}
	.count {
		font-size: 13px;
		color: var(--muted);
	}
	.bars {
		flex: 1 1 240px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.bar-row {
		display: grid;
		grid-template-columns: 28px 1fr;
		align-items: center;
		gap: 10px;
		font-size: 13px;
	}
	dt {
		color: var(--muted);
	}
	dd {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.track {
		flex: 1;
		height: 6px;
		border-radius: 999px;
		background: var(--line-2);
		overflow: hidden;
	}
	.fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--star);
	}
	.share {
		width: 34px;
		text-align: right;
		color: var(--muted);
	}
</style>
