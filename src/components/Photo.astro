---
// A photo with the design's frame. Without `photo` it falls back to a labelled placeholder.
import type { SitePhoto } from '../data/photos';

interface Props {
	label: string;
	photo?: SitePhoto;
	/** Keep the label visible over the photo, e.g. gallery captions. */
	caption?: boolean;
	tone?: 'photo' | 'photo-2' | 'photo-3';
	height?: string;
	radius?: string;
	align?: 'top' | 'bottom';
	position?: string;
	class?: string;
}

const { label, photo, caption = false, tone = 'photo', height, radius = '18px', align = 'bottom', position, class: className } = Astro.props;
---

{
	photo ? (
		<figure class:list={['photo', 'photo--img', `photo--${tone}`, className]} style={{ height, borderRadius: radius }}>
			<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" style={{ objectPosition: position }} />
			{caption && <figcaption>{label}</figcaption>}
		</figure>
	) : (
		<div class:list={['photo', `photo--${tone}`, `photo--${align}`, className]} style={{ height, borderRadius: radius }} role="img" aria-label={label}>
			<span>{label}</span>
		</div>
	)
}

<style>
	.photo {
		display: flex;
		padding: 18px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--photo-text);
	}
	.photo--bottom {
		align-items: flex-end;
	}
	.photo--top {
		align-items: flex-start;
	}
	.photo--photo {
		background: var(--photo);
	}
	.photo--photo-2 {
		background: var(--photo-2);
	}
	.photo--photo-3 {
		background: var(--photo-3);
	}

	.photo--img {
		position: relative;
		margin: 0;
		overflow: hidden;
		align-items: flex-end;
	}
	.photo--img img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	figcaption {
		position: relative;
		padding: 6px 12px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.9);
		color: var(--ink);
	}
</style>
