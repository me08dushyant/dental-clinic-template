---
import Icon from './Icon.astro';
import { routes, site } from '../data/site';

export type NavKey = 'home' | 'about' | 'dentist' | 'services' | 'reviews' | 'contact';

interface Props {
	active?: NavKey;
	bookHref?: string;
	/** `dark` sits on a photo hero (light text); `light` sits on the cream canvas (dark text). */
	tone?: 'dark' | 'light';
}

const { active, bookHref = routes.contact, tone = 'dark' } = Astro.props;

const links: { key: NavKey; label: string; href: string }[] = [
	{ key: 'about', label: 'About', href: routes.about },
	{ key: 'dentist', label: 'Our Dentist', href: routes.dentist },
	{ key: 'services', label: 'Treatments', href: routes.services },
	{ key: 'reviews', label: 'Reviews', href: routes.reviews },
	{ key: 'contact', label: 'Contact', href: routes.contact },
];
---

<header class:list={['header', `header--${tone}`]} data-header>
	<div class="shell">
		<div class="container bar">
			<a href={routes.home} class="brand" aria-label={`${site.name}, home`}>
				<span class="brand-mark"><Icon name="tooth" size={20} strokeWidth={1.6} /></span>{site.name}
			</a>
			<button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
				<span class="sr-only">Menu</span>
				<Icon name="menu" size={24} strokeWidth={2} class="icon-open" />
				<Icon name="close" size={24} strokeWidth={2} class="icon-close" />
			</button>
			<div id="site-menu" class="menu" data-menu>
				<nav aria-label="Main" class="nav">
					{
						links.map((link) => (
							<a href={link.href} class:list={['nav-link', { active: link.key === active }]} aria-current={link.key === active ? 'page' : undefined}>
								{link.label}
							</a>
						))
					}
				</nav>
				<div class="actions">
					<a href={site.phoneHref} class="btn btn--sm call-btn"><Icon name="phone" size={16} strokeWidth={1.8} />Call now</a>
					<a href={bookHref} class="btn btn--sm book-btn">Book consultation</a>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	// Mobile menu toggle; the menu is always visible on wide screens.
	const button = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	if (button && menu) {
		const setOpen = (open: boolean) => {
			button.setAttribute('aria-expanded', String(open));
			menu.classList.toggle('is-open', open);
		};
		button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.classList.contains('is-open')) {
				setOpen(false);
				button.focus();
			}
		});
	}

	// Pin a compact bar to the top once the in-hero header scrolls out of view (wide screens, via CSS).
	// The header keeps its height so the hero doesn't jump when the bar detaches.
	const header = document.querySelector<HTMLElement>('[data-header]');
	if (header) {
		const lockHeight = () => {
			header.style.height = '';
			header.style.height = `${header.offsetHeight}px`;
		};
		lockHeight();
		addEventListener('resize', lockHeight);
		new IntersectionObserver(([entry]) => header.classList.toggle('is-stuck', !entry.isIntersecting)).observe(header);
	}
</script>

<style>
	.header {
		position: relative;
		z-index: 5;
		--h-text: var(--white);
		--h-muted: var(--on-dark);
		--h-line: rgba(255, 255, 255, 0.22);
		--h-panel: var(--dark);
	}
	.header--light {
		--h-text: var(--ink);
		--h-muted: var(--body-2);
		--h-line: var(--line);
		--h-panel: var(--bg);
	}
	.header--light .shell {
		border-bottom: 1px solid var(--line-2);
	}
	.bar {
		padding-block: 22px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 32px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--h-text);
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 19px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.brand:hover {
		color: var(--h-text);
	}
	.brand-mark {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid var(--h-line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent-soft);
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 32px;
		font-size: 14px;
		font-weight: 500;
	}
	.nav-link {
		color: var(--h-muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		padding-block: 4px;
	}
	.nav-link:hover {
		color: var(--h-text);
	}
	.nav-link.active {
		color: var(--h-text);
		border-bottom-color: var(--accent-soft);
	}
	.actions {
		display: flex;
		gap: 10px;
	}
	.call-btn {
		border: 1px solid var(--h-line);
		color: var(--h-text);
		background: transparent;
	}
	.call-btn:hover {
		border-color: var(--h-text);
		color: var(--h-text);
	}
	.book-btn {
		background: var(--white);
		color: var(--ink);
	}
	.book-btn:hover {
		background: var(--tint);
		color: var(--ink);
	}
	.header--light .book-btn {
		background: var(--primary);
		color: var(--white);
	}
	.header--light .book-btn:hover {
		background: var(--primary-dark);
	}
	.menu {
		display: contents;
	}
	.menu-btn {
		display: none;
	}

	@media (min-width: 961px) {
		.is-stuck .shell {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			background: var(--h-panel);
			box-shadow: 0 10px 30px -18px rgba(42, 33, 27, 0.5);
			animation: slide-down 0.25s ease;
		}
		.header--light.is-stuck .shell {
			background: rgba(248, 245, 240, 0.92);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
		}
		.is-stuck .bar {
			padding-block: 12px;
		}
	}
	@keyframes slide-down {
		from {
			transform: translateY(-100%);
		}
	}

	/* Mid widths: drop the call button before the nav starts wrapping */
	@media (max-width: 1180px) and (min-width: 961px) {
		.call-btn {
			display: none;
		}
	}

	@media (max-width: 960px) {
		.bar {
			position: relative;
			padding-block: 16px;
		}
		.menu-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 48px;
			height: 48px;
			border-radius: 50%;
			border: 1px solid var(--h-line);
			background: transparent;
			color: var(--h-text);
			cursor: pointer;
		}
		.menu-btn :global(.icon-close),
		.menu-btn[aria-expanded='true'] :global(.icon-open) {
			display: none;
		}
		.menu-btn[aria-expanded='true'] :global(.icon-close) {
			display: block;
		}
		.menu {
			display: none;
			position: absolute;
			top: 100%;
			left: var(--gutter);
			right: var(--gutter);
			z-index: 10;
			flex-direction: column;
			gap: 20px;
			padding: 20px;
			border-radius: 20px;
			background: var(--dark);
			box-shadow: var(--shadow-card);
		}
		.menu.is-open {
			display: flex;
		}
		.nav {
			flex-direction: column;
			gap: 0;
			font-size: 17px;
		}
		.nav-link {
			display: flex;
			align-items: center;
			min-height: 48px;
			color: var(--on-dark);
			border-bottom: 1px solid var(--dark-line);
		}
		.nav-link:hover,
		.nav-link.active {
			color: var(--white);
			border-bottom-color: var(--dark-line);
		}
		.nav-link.active {
			color: var(--accent-light);
		}
		.actions {
			flex-direction: column;
		}
		.actions .btn {
			min-height: 52px;
		}
		.call-btn,
		.header--light .call-btn {
			border-color: var(--dark-line);
			color: var(--white);
		}
		.book-btn,
		.header--light .book-btn {
			background: var(--white);
			color: var(--ink);
		}
	}
</style>
