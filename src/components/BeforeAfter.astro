---
// Side-by-side before/after pair. Without `pair` it falls back to labelled placeholders.
import type { SmileCase } from '../data/photos';

interface Props {
	label: string;
	meta?: string;
	height?: string;
	pair?: SmileCase;
}

const { label, meta, height = '200px', pair } = Astro.props;
---

<figure class="case">
	<div class="pair">
		<div class="side before" style={{ height }}>
			{pair && <img src={pair.before} alt={`${label}, before treatment`} loading="lazy" decoding="async" />}
			<span class="tag">BEFORE</span>
		</div>
		<div class="side after" style={{ height }}>
			{pair && <img src={pair.after} alt={`${label}, after treatment`} loading="lazy" decoding="async" />}
			<span class="tag">AFTER</span>
		</div>
		{pair?.sample && <span class="sample">Sample image</span>}
	</div>
	<figcaption>
		<strong>{label}</strong>
		{meta && <span class="meta">{meta}</span>}
	</figcaption>
</figure>

<style>
	.case {
		padding: 14px;
		border-radius: 18px;
		background: var(--white);
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.pair {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 6px;
	}
	.side {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		padding: 12px;
		font-size: 12px;
		font-weight: 700;
	}
	.side img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.before {
		border-radius: 12px 0 0 12px;
		background: var(--before);
		color: var(--photo-text);
	}
	.after {
		border-radius: 0 12px 12px 0;
		background: var(--photo);
		color: var(--primary);
	}
	.tag {
		position: relative;
	}
	/* Over a photo the label needs its own backing to stay readable */
	img + .tag {
		padding: 3px 9px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.9);
		letter-spacing: 0.06em;
	}
	.sample {
		position: absolute;
		top: 10px;
		left: 50%;
		transform: translateX(-50%);
		padding: 3px 10px;
		border-radius: 999px;
		background: rgba(43, 33, 27, 0.85);
		color: var(--white);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}
	figcaption {
		padding: 0 6px 6px;
		display: flex;
		justify-content: space-between;
		gap: 12px;
	}
	.meta {
		color: var(--muted);
		font-size: 15px;
	}
</style>
