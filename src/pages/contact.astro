---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { site } from '../data/site';
import { photos } from '../data/photos';

const reasons = ['Check-up & cleaning', 'Tooth pain / emergency', 'Root canal', 'Implants', 'Braces / aligners', 'Whitening / cosmetic', "Child's visit", 'Other'];
const slots = ['Morning', 'Afternoon', 'Evening'];
---

<BaseLayout
	title={`Book an Appointment | ${site.name}, ${site.area}, ${site.city}`}
	description={`Book a dental appointment at ${site.name}, ${site.street}, ${site.area}. Request a time online, WhatsApp ${site.phoneDisplay} or call. We confirm within ${site.confirmWithin}.`}
	crumbs={[{ label: 'Contact' }]}
>
	<PageHero
		title="Book your visit."
		lead={`Fill in the form, WhatsApp us, or just call. We confirm every request within ${site.confirmWithin}.`}
		photo={photos.heroContact}
		padBottom="160px"
		active="contact"
		bookHref="#book"
		crumbs={[{ label: 'Contact' }]}
	/>

	<section id="book" aria-label="Booking" class="book">
		<div class="container book-grid">
			<div class="form-card">
				<div class="success" role="status" tabindex="-1" hidden data-success>
					<span class="success-icon"><Icon name="check" size={30} strokeWidth={2.4} /></span>
					<h2 class="success-title" data-success-title>Almost done</h2>
					<p class="muted" data-success-text>Send your request on WhatsApp and our front desk will confirm your appointment.</p>
					<dl class="summary" data-summary></dl>
					<div class="btn-row">
						<a href={site.whatsapp} class="btn btn--md btn--whatsapp" target="_blank" rel="noopener" data-wa-send
							><Icon name="whatsapp" size={18} strokeWidth={1.8} /><span data-wa-label>Send on WhatsApp</span></a
						>
						<button type="button" class="btn btn--md btn--outline" data-reset>Edit or start again</button>
					</div>
				</div>

				<form class="form" novalidate data-booking-form data-endpoint={site.bookingEndpoint} data-phone={site.phone} data-clinic={site.name}>
					<div class="form-head">
						<p class="eyebrow">Appointment</p>
						<h2 class="form-title">Request a time</h2>
						<p class="muted form-note">Takes under a minute. Fields marked * are required.</p>
					</div>
					<div class="fields">
						<div class="field">
							<label for="f-name">Full name *</label>
							<input id="f-name" name="name" type="text" required autocomplete="name" aria-describedby="f-name-err" />
							<span id="f-name-err" class="error" data-error>Please enter your name.</span>
						</div>
						<div class="field">
							<label for="f-phone">Mobile number *</label>
							<input
								id="f-phone"
								name="phone"
								type="tel"
								required
								autocomplete="tel"
								inputmode="tel"
								pattern="(\+?91[\s\-]?)?[6-9][0-9]{4}[\s\-]?[0-9]{5}"
								placeholder="98765 43210"
								aria-describedby="f-phone-err"
							/>
							<span id="f-phone-err" class="error" data-error>Enter a 10-digit Indian mobile number.</span>
						</div>
						<div class="field">
							<label for="f-treat">Reason for visit</label>
							<select id="f-treat" name="reason">
								{reasons.map((r) => <option>{r}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="f-date">Preferred date</label>
							<input id="f-date" name="date" type="date" aria-describedby="f-date-err" />
							<span id="f-date-err" class="error" data-error>Choose today or a later date.</span>
						</div>
					</div>
					<fieldset class="slots">
						<legend>Preferred time</legend>
						<div class="slot-row">
							{
								slots.map((s, i) => (
									<label class="slot">
										<input type="radio" name="slot" value={s} checked={i === 0} />
										{s}
									</label>
								))
							}
						</div>
					</fieldset>
					<div class="field">
						<label for="f-msg">Anything we should know? <span class="optional">(optional)</span></label>
						<textarea id="f-msg" name="message" rows="4" maxlength="500"></textarea>
					</div>
					<label class="consent">
						<input type="checkbox" name="consent" required aria-describedby="f-consent-err" />
						<span>I agree to be contacted by phone or WhatsApp about my appointment. *</span>
					</label>
					<span id="f-consent-err" class="error error--consent" data-error>Please tick the box so we can contact you.</span>
					<p class="form-error" role="alert" hidden data-form-error>We couldn't send your request just now. <a href={site.whatsapp} target="_blank" rel="noopener" data-wa-fallback>Send it on WhatsApp instead</a>, or call {site.phoneDisplay}.</p>
					<button type="submit" class="btn btn--lg btn--primary btn--shadow submit" data-submit>Request appointment</button>
				</form>
			</div>

			<aside aria-label="Other ways to reach us" class="aside">
				<a href={site.whatsapp} class="wa">
					<span class="wa-head"><span class="wa-icon"><Icon name="whatsapp" size={24} strokeWidth={1.8} /></span><span class="wa-title">Book on WhatsApp</span></span>
					<span class="wa-text">Fastest way. Send your name, day and reason for visit, and we reply within minutes during clinic hours.</span>
					<strong>{site.phoneDisplay}</strong>
				</a>
				<div class="details">
					<div class="detail">
						<span class="detail-icon"><Icon name="phone" size={20} strokeWidth={1.8} /></span>
						<span class="detail-text"><span>Call us</span><a href={site.phoneHref}>{site.phoneDisplay}</a></span>
					</div>
					<div class="detail">
						<span class="detail-icon"><Icon name="mail" size={20} strokeWidth={1.8} /></span>
						<span class="detail-text"><span>Email</span><a href={site.emailHref}>{site.email}</a></span>
					</div>
					<div class="hours">
						<span class="hours-label">Opening hours</span>
						<OpenStatus />
						{
							site.hours.map(([day, time]) => (
								<div class="hour">
									<span>{day}</span>
									<strong>{time}</strong>
								</div>
							))
						}
					</div>
				</div>
				<div class="emergency">
					<strong>Dental emergency?</strong>
					<span>Call {site.phoneDisplay} for same-day help with pain, swelling or a broken tooth.</span>
				</div>
			</aside>
		</div>
	</section>

	<section aria-labelledby="loc-title" class="section bg-soft">
		<div class="container location">
			<div class="loc-card">
				<p class="eyebrow">Location</p>
				<h2 id="loc-title" class="loc-title">Find the clinic</h2>
				<p class="address">{site.street}<br />{site.area}, {site.city} – {site.postalCode}</p>
				<ul class="loc-list">
					<li><Icon name="pin" size={18} strokeWidth={1.6} />{site.landmark}</li>
					<li><Icon name="chair" size={18} strokeWidth={1.6} />{site.parking}</li>
					<li><Icon name="access" size={18} strokeWidth={1.6} />{site.access}</li>
				</ul>
				<a href={site.maps} class="btn btn--primary directions">Get directions</a>
			</div>
			<MapPlaceholder minHeight="460px" class="loc-map" />
		</div>
	</section>
</BaseLayout>

<script>
	// Validates the booking form, then either posts it to `site.bookingEndpoint` (when set) or hands the
	// request over to WhatsApp with every detail pre-filled, so no request is ever lost.
	const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
	const success = document.querySelector<HTMLElement>('[data-success]');
	const reset = document.querySelector<HTMLButtonElement>('[data-reset]');
	const waSend = document.querySelector<HTMLAnchorElement>('[data-wa-send]');
	const summary = document.querySelector<HTMLElement>('[data-summary]');
	const formError = document.querySelector<HTMLElement>('[data-form-error]');
	const submit = document.querySelector<HTMLButtonElement>('[data-submit]');

	// No past dates in the picker (local date, not UTC)
	const date = document.querySelector<HTMLInputElement>('#f-date');
	if (date) {
		const now = new Date();
		date.min = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
	}

	// Treatment pages link here with ?reason=Implants to preselect the reason
	const reason = new URLSearchParams(location.search).get('reason');
	const select = document.querySelector<HTMLSelectElement>('#f-treat');
	if (reason && select) {
		const match = [...select.options].find((o) => o.value.toLowerCase().includes(reason.toLowerCase()));
		if (match) select.value = match.value;
	}

	const formatDate = (value: string) =>
		value ? new Date(`${value}T00:00`).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : 'Any day';

	if (form && success && reset && waSend && summary && formError && submit) {
		const { endpoint = '', phone = '', clinic = '' } = form.dataset;

		// Show each field's message once the patient has interacted with it, not before
		const showErrors = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) =>
			field.closest('.field, .consent')?.classList.toggle('is-invalid', !field.validity.valid);
		form.addEventListener('focusout', (event) => {
			const field = event.target as HTMLInputElement;
			if (field.willValidate && field.value) showErrors(field);
		});
		form.addEventListener('input', (event) => {
			const field = event.target as HTMLInputElement;
			if (field.closest('.is-invalid')) showErrors(field);
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			formError.hidden = true;
			const fields = [...form.elements].filter((el): el is HTMLInputElement => 'willValidate' in el && (el as HTMLInputElement).willValidate);
			fields.forEach(showErrors);
			const firstInvalid = fields.find((f) => !f.validity.valid);
			if (firstInvalid) {
				firstInvalid.focus();
				return;
			}

			const data = new FormData(form);
			const details = {
				name: String(data.get('name')).trim(),
				phone: String(data.get('phone')).trim(),
				reason: String(data.get('reason')),
				date: formatDate(String(data.get('date') ?? '')),
				time: String(data.get('slot')),
				message: String(data.get('message') ?? '').trim(),
			};

			const lines = [
				`Hi ${clinic}, I'd like to book an appointment.`,
				`Name: ${details.name}`,
				`Mobile: ${details.phone}`,
				`Reason: ${details.reason}`,
				`Preferred: ${details.date}, ${details.time.toLowerCase()}`,
				details.message && `Note: ${details.message}`,
			].filter(Boolean);
			waSend.href = `https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`;
			formError.querySelector<HTMLAnchorElement>('[data-wa-fallback]')?.setAttribute('href', waSend.href);

			summary.replaceChildren(
				...[
					['Name', details.name],
					['Mobile', details.phone],
					['Reason', details.reason],
					['Preferred', `${details.date} · ${details.time}`],
				].flatMap(([term, value]) => {
					const dt = document.createElement('dt');
					const dd = document.createElement('dd');
					dt.textContent = term;
					dd.textContent = value;
					return [dt, dd];
				}),
			);

			const title = success.querySelector('[data-success-title]')!;
			const text = success.querySelector('[data-success-text]')!;
			const label = waSend.querySelector('[data-wa-label]')!;

			if (endpoint) {
				submit.disabled = true;
				submit.textContent = 'Sending…';
				try {
					const response = await fetch(endpoint, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify(details),
					});
					if (!response.ok) throw new Error(`Booking endpoint returned ${response.status}`);
					title.textContent = 'Request received';
					text.textContent = `Thank you, ${details.name.split(' ')[0]}. Our front desk will call or WhatsApp you shortly to confirm.`;
					label.textContent = 'Also message us on WhatsApp';
					waSend.classList.replace('btn--whatsapp', 'btn--outline');
				} catch {
					formError.hidden = false;
					return;
				} finally {
					submit.disabled = false;
					submit.textContent = 'Request appointment';
				}
			} else {
				title.textContent = 'Almost done';
				text.textContent = 'Tap below to send these details on WhatsApp. Our front desk will confirm your appointment there.';
				label.textContent = 'Send on WhatsApp';
			}

			form.hidden = true;
			success.hidden = false;
			success.focus();
		});

		reset.addEventListener('click', () => {
			success.hidden = true;
			form.hidden = false;
			form.querySelector<HTMLInputElement>('#f-name')?.focus();
		});
	}
</script>

<style>
	.book {
		position: relative;
		z-index: 2;
		margin-top: -110px;
		padding-bottom: var(--section-y);
	}
	.book-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		align-items: flex-start;
	}
	.form-card {
		flex: 1.6 1 560px;
		min-width: 0;
		padding: clamp(24px, 4vw, 48px);
		border-radius: 28px;
		background: var(--white);
		border: 1px solid var(--line-2);
		box-shadow: 0 30px 60px -36px rgba(43, 33, 27, 0.5);
	}

	.success {
		display: flex;
		flex-direction: column;
		gap: 16px;
		align-items: flex-start;
		padding: 32px 0;
		outline: none;
	}
	.success[hidden],
	.form[hidden] {
		display: none;
	}
	.success-icon {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--tint);
		color: #1f8a4c;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.success-title {
		font-size: 32px;
		font-weight: 500;
	}
	.success p {
		max-width: 32em;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.form-head {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.form-title {
		font-size: 30px;
		font-weight: 500;
	}
	.fields {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
		gap: 16px;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.field label,
	.slots legend {
		font-size: 15px;
		font-weight: 600;
	}
	.form-note {
		font-size: 14px;
		margin-top: 4px;
	}
	.error {
		display: none;
		font-size: 13px;
		color: #a2361f;
	}
	.is-invalid .error,
	.consent.is-invalid + .error--consent {
		display: block;
	}
	.is-invalid input,
	.is-invalid select {
		border-color: #a2361f;
	}
	.error--consent {
		margin-top: -12px;
		padding-left: 30px;
	}
	.form-error {
		padding: 12px 16px;
		border-radius: 12px;
		background: #fbe9e4;
		color: #8a2b17;
		font-size: 14px;
	}
	.form-error a {
		color: inherit;
		font-weight: 600;
	}
	.form-error[hidden] {
		display: none;
	}
	.summary {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 8px 24px;
		width: 100%;
		max-width: 520px;
		padding: 18px 22px;
		border-radius: 16px;
		background: var(--bg);
		font-size: 15px;
	}
	.summary dt {
		color: var(--muted);
	}
	.summary dd {
		font-weight: 600;
	}
	.submit:disabled {
		opacity: 0.7;
		cursor: progress;
	}

	.optional {
		font-weight: 400;
		color: var(--muted);
	}
	.field input,
	.field select,
	.field textarea {
		min-height: 52px;
		padding: 0 16px;
		border-radius: 10px;
		border: 1px solid var(--field);
		background: var(--field-bg);
	}
	.field textarea {
		padding: 14px 16px;
		resize: vertical;
	}
	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
		border-color: var(--primary);
	}
	.slots {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.slots legend {
		padding: 0;
		margin-bottom: 10px;
	}
	.slot-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.slot {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 46px;
		padding: 0 18px;
		border-radius: 10px;
		border: 1px solid var(--field);
		cursor: pointer;
	}
	.slot:has(input:checked) {
		border-color: var(--primary);
		background: var(--tint);
	}
	.slot input,
	.consent input {
		accent-color: var(--primary);
	}
	.consent {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		font-size: 15px;
		color: var(--muted);
	}
	.consent input {
		flex: none;
		width: 20px;
		height: 20px;
		margin-top: 2px;
	}
	.submit {
		align-self: flex-start;
		padding-inline: 32px;
		font-size: 17px;
	}

	.aside {
		flex: 1 1 340px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.wa {
		padding: 28px;
		border-radius: 20px;
		background: var(--primary);
		color: var(--white);
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 12px;
		box-shadow: var(--shadow-primary);
		transition: background-color 0.15s ease;
	}
	.wa:hover {
		background: var(--primary-dark);
		color: var(--white);
	}
	.wa-head {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.wa-icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #1f8a4c;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.wa-title {
		font-size: 22px;
		font-weight: 700;
	}
	.wa-text {
		color: var(--on-primary);
	}
	.details {
		padding: 28px;
		border-radius: 20px;
		background: var(--soft);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.detail {
		display: flex;
		gap: 14px;
		align-items: center;
	}
	.detail-icon {
		flex: 0 0 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--white);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.detail-text {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		min-width: 0;
	}
	.detail-text span {
		font-size: 14px;
		color: var(--muted);
	}
	.detail-text a {
		color: var(--ink);
		text-decoration: none;
		font-weight: 700;
	}
	.hours {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}
	.hours-label {
		font-size: 14px;
		color: var(--muted);
	}
	.hour {
		display: flex;
		justify-content: space-between;
		gap: 16px;
	}
	.emergency {
		padding: 22px 28px;
		border-radius: 20px;
		background: var(--dark);
		color: var(--white);
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.emergency span {
		color: var(--on-dark-2);
	}

	.location {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}
	.loc-card {
		flex: 1 1 380px;
		min-width: 0;
		padding: clamp(28px, 4vw, 40px);
		border-radius: 18px;
		background: var(--white);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.loc-title {
		font-weight: 700;
		font-size: clamp(30px, 3vw, 40px);
		line-height: 1.15;
	}
	.address {
		font-size: 18px;
	}
	.loc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: var(--muted);
	}
	.loc-list li {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.loc-list :global(svg) {
		flex: none;
		color: var(--accent);
	}
	.directions {
		align-self: flex-start;
	}
	.location :global(.loc-map) {
		flex: 1.4 1 520px;
		min-width: 0;
	}
</style>
