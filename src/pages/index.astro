---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GlassStats from '../components/GlassStats.astro';
import IconCard from '../components/IconCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import FaqList from '../components/FaqList.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { routes, site } from '../data/site';
import { photos } from '../data/photos';

const stats = [
	{ value: '[15+]', label: 'years of experience' },
	{ value: '[4.9★]', label: 'Google rating' },
	{ value: '[10,000+]', label: 'smiles treated' },
	{ value: '[24h]', label: 'same-day emergency' },
];

const treatments = [
	{ icon: 'toothCheck', title: 'Check-ups &amp;<br>Cleaning', href: routes.general },
	{ icon: 'kids', title: "Children's<br>Dentistry", href: routes.general, featured: true },
	{ icon: 'rootCanal', title: 'Root Canal<br>Treatment', href: `${routes.treatments}#rct` },
	{ icon: 'implant', title: 'Dental<br>Implants', href: `${routes.treatments}#implants` },
	{ icon: 'braces', title: 'Braces &amp;<br>Aligners', href: `${routes.treatments}#braces` },
	{ icon: 'whitening', title: 'Whitening &amp;<br>Smile Design', href: routes.cosmetic },
] as const;

const credentials = [
	{ strong: 'BDS, MDS in [Specialisation]', rest: ', [University]' },
	{ strong: 'Certified in [Implantology]', rest: ', [Institute]' },
	{ strong: 'Member', rest: ', [Indian Dental Association]' },
];

const reasons = [
	{ title: 'Spotless hygiene', text: 'Autoclaved, sealed instruments opened in front of you.' },
	{ title: 'Modern technology', text: 'Digital X-rays and intraoral cameras for precise care.' },
	{ title: 'Comfort first', text: 'Gentle numbing, longer slots, breaks whenever you need.' },
	{ title: 'Clear pricing', text: 'Written estimates before treatment, EMI available.' },
];

const reviews = [
	{ quote: '[Real Google review about a calm, painless first visit.]', name: '[Patient name]', meta: '[Root canal]', tone: 'soft' },
	{ quote: "[Real Google review from a parent about their child's visit.]", name: '[Parent name]', meta: "Kids' dentistry", tone: 'blue' },
	{ quote: '[Real Google review about implants or whitening results.]', name: '[Patient name]', meta: '[Implants]', tone: 'soft' },
] as const;

const gallery = [
	{ label: 'Treatment room', photo: photos.treatmentRoom, tall: true },
	{ label: 'Reception', photo: photos.reception },
	{ label: 'Sterilisation area', photo: photos.sterilisation },
	{ label: 'Digital X-ray', photo: photos.digitalXray },
	{ label: "Kids' corner", photo: photos.kidsDentist },
];

const faqs = [
	{ q: 'When should my child first see a dentist?', a: 'By their first birthday or when the first tooth appears.' },
	{ q: 'Is root canal treatment painful?', a: 'With modern anaesthesia it feels much like a filling.' },
	{ q: 'Can I book on WhatsApp?', a: 'Yes. Send your name, preferred day and reason for visit.' },
	{ q: 'Do you offer EMI?', a: '[Add your payment policy here.]' },
];
---

<BaseLayout title={`${site.name} — Home`}>
	<PageHero
		home
		titleId="hero-title"
		title="Gentle dental care, brighter family smiles."
		photo={photos.heroHome}
		photoPosition="70% center"
		padBottom="0"
		active="home"
	>
		<div slot="top" class="badge-row">
			<div class="badge">
				<span class="faces" aria-hidden="true"><span></span><span></span><span></span></span>
				<span class="badge-text"><strong>[10K+]</strong><span>Happy patients</span></span>
				<span class="badge-check"><Icon name="check" size={12} strokeWidth={3.5} /></span>
			</div>
		</div>
		<div class="intro">
			<p class="intro-text">
				From your child's first check-up to implants and smile makeovers, our experienced team gives every patient calm, unhurried, personal care.
			</p>
		</div>
		<div class="hero-actions">
			<a href={routes.contact} class="btn btn--blue">Book appointment</a>
			<a href={site.whatsapp} class="wa-link">
				<span class="wa-ring"><Icon name="whatsapp" size={18} strokeWidth={1.8} /></span>Chat on WhatsApp
			</a>
		</div>
		<div slot="after" class="stats-gap">
			<GlassStats items={stats} />
		</div>
	</PageHero>

	<section aria-labelledby="about-title" class="section">
		<div aria-hidden="true" class="blob home-blob"></div>
		<div class="container split">
			<div class="about-copy">
				<p class="eyebrow">About us</p>
				<h2 id="about-title" class="h2">Aster is a family dental clinic led by experienced, caring professionals</h2>
				<p class="muted about-text">
					We focus on prevention, honest advice and comfortable treatment. Every plan is explained in plain language, with costs in writing before we begin.
				</p>
				<a href={routes.about} class="text-link">Learn about the clinic<Icon name="arrow" size={16} strokeWidth={2.2} /></a>
			</div>
			<Photo label="Photo · Dental team treating a patient" photo={photos.teamTreating} height="320px" class="about-photo" />
		</div>
	</section>

	<section aria-labelledby="tx-title" class="section section--flush-top">
		<div class="container stack">
			<div class="section-head section-head--center">
				<p class="eyebrow">Our treatments</p>
				<h2 id="tx-title" class="h2">For Your Smile</h2>
			</div>
			<div class="card-grid">
				{treatments.map((t) => <IconCard icon={t.icon} title={t.title} href={t.href} featured={'featured' in t && t.featured} tall />)}
			</div>
		</div>
	</section>

	<section aria-labelledby="dr-title" class="section bg-soft">
		<div class="container split">
			<div class="dr-media">
				<Photo label="Photo · Portrait of Dr. [Name]" photo={photos.dentistPortrait} height="540px" position="center 20%" />
				<div class="dr-card">
					<span class="dr-name"><strong>Dr. [Full Name]</strong><span>BDS, MDS · [Specialisation]</span></span>
					<span class="pill">[15+] yrs</span>
				</div>
			</div>
			<div class="dr-copy">
				<p class="eyebrow">Meet your dentist</p>
				<h2 id="dr-title" class="h2">Expert hands, a gentle approach</h2>
				<p class="muted">[2–3 lines on the dentist's training, focus areas and what patients love about them.]</p>
				<ul class="checks">
					{
						credentials.map((c) => (
							<li>
								<span class="check-dot">
									<Icon name="check" size={13} strokeWidth={3.5} />
								</span>
								<span>
									<strong>{c.strong}</strong>
									{c.rest}
								</span>
							</li>
						))
					}
				</ul>
				<a href={routes.dentist} class="btn btn--md btn--outline-blue dr-btn">View full profile</a>
			</div>
		</div>
	</section>

	<section aria-labelledby="why-title" class="section">
		<div class="container">
			<div class="panel-dark why">
				<div class="why-head">
					<p class="eyebrow eyebrow--light">Why choose us</p>
					<h2 id="why-title" class="why-title">Care you can feel from the first visit</h2>
					<a href={routes.contact} class="btn btn--md btn--white why-btn">Book a visit</a>
				</div>
				<div class="why-grid">
					{
						reasons.map((r) => (
							<div class="why-item">
								<h3>{r.title}</h3>
								<p>{r.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section aria-labelledby="rev-title" class="section section--flush-top">
		<div class="container stack">
			<div class="section-head section-head--center">
				<p class="eyebrow">Testimonials</p>
				<h2 id="rev-title" class="h2">What Our Patients Say</h2>
			</div>
			<div class="review-grid">
				{reviews.map((r) => <ReviewCard quote={r.quote} name={r.name} meta={r.meta} tone={r.tone} featured />)}
			</div>
		</div>
	</section>

	<section aria-labelledby="gal-title" class="section bg-soft">
		<div class="container stack" style="--stack-gap: 40px">
			<div class="heading-row">
				<div class="section-head">
					<p class="eyebrow">Our clinic</p>
					<h2 id="gal-title" class="h2">Clean, calm and modern</h2>
				</div>
				<a href={routes.about} class="text-link">Explore facilities</a>
			</div>
			<div class="gallery">
				{gallery.map((g) => <Photo label={g.label} photo={g.photo} caption radius="16px" class={g.tall ? 'tall' : undefined} />)}
			</div>
		</div>
	</section>

	<section aria-labelledby="faq-title" class="section">
		<div class="container container--narrow stack" style="--stack-gap: 40px">
			<div class="section-head section-head--center">
				<p class="eyebrow">FAQ</p>
				<h2 id="faq-title" class="h2">Common Questions</h2>
			</div>
			<FaqList items={faqs} />
		</div>
	</section>

	<section aria-labelledby="visit-title" class="section section--flush-top">
		<div class="container visit">
			<MapPlaceholder class="visit-map" />
			<div class="visit-card">
				<h2 id="visit-title" class="visit-title">Visit the clinic</h2>
				<OpenStatus />
				<p class="visit-address">[Building, Street]<br />[Area], {site.city} [PIN]</p>
				<dl class="visit-list">
					<dt>Mon – Sat</dt><dd>[10:00 – 20:00]</dd>
					<dt>Sunday</dt><dd>[Emergencies only]</dd>
					<dt>Phone</dt><dd><a href={site.phoneHref}>{site.phoneDisplay}</a></dd>
				</dl>
				<a href={site.maps} class="btn btn--md btn--blue visit-btn">Get directions</a>
			</div>
		</div>
	</section>

	<CtaBand
		title="Ready for a healthier smile?"
		text="Book online or on WhatsApp. We confirm within [2 hours]."
		primary={{ label: 'Book appointment', href: routes.contact }}
		secondary={{ label: 'WhatsApp us', href: site.whatsapp }}
	/>
</BaseLayout>

<style>
	/* Hero */
	.badge-row {
		display: flex;
		justify-content: flex-end;
	}
	.badge {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 16px 8px 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.85);
	}
	.faces {
		display: flex;
	}
	.faces span {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 2px solid var(--white);
		background: var(--avatar);
	}
	.faces span + span {
		margin-left: -10px;
	}
	.faces span:nth-child(2) {
		background: #9fbcdb;
	}
	.faces span:nth-child(3) {
		background: #86a9cf;
	}
	.badge-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}
	.badge-text strong {
		font-size: 17px;
		color: var(--ink);
	}
	.badge-text span {
		font-size: 12px;
		color: #4a6683;
	}
	.badge-check {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--blue);
		color: var(--white);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.intro {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 56px;
		max-width: 640px;
	}
	.intro-text {
		flex: 1 1 320px;
		color: var(--on-dark);
		font-size: 16px;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		align-items: center;
	}
	.wa-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		min-height: 52px;
		color: var(--white);
		text-decoration: none;
		font-weight: 600;
		font-size: 15px;
	}
	.wa-link:hover {
		color: var(--white);
	}
	.wa-ring {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1.5px solid var(--white);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.15s ease;
	}
	.wa-link:hover .wa-ring {
		background: rgba(255, 255, 255, 0.15);
	}
	.stats-gap {
		margin-top: 48px;
	}

	/* About */
	.home-blob {
		right: -120px;
		top: -40px;
		width: 620px;
		height: 560px;
	}
	.about-copy {
		flex: 1 1 460px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.about-text {
		margin-top: 24px;
		max-width: 30em;
	}
	.about-copy .text-link {
		align-self: flex-start;
		margin-top: 8px;
	}
	.split :global(.about-photo) {
		flex: 1 1 420px;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 20px;
	}

	/* Dentist */
	.dr-media {
		flex: 1 1 420px;
		position: relative;
	}
	.dr-card {
		position: absolute;
		left: 24px;
		right: 24px;
		bottom: 24px;
		background: var(--white);
		border-radius: 14px;
		padding: 18px 22px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		box-shadow: 0 16px 36px -18px rgba(31, 59, 91, 0.45);
	}
	.dr-name {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.dr-name strong {
		font-size: 18px;
	}
	.dr-name span {
		font-size: 14px;
		color: var(--muted);
	}
	.dr-card .pill {
		align-self: center;
		font-size: 13px;
		padding: 6px 12px;
		white-space: nowrap;
	}
	.dr-copy {
		flex: 1 1 460px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.checks {
		margin: 8px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.checks li {
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}
	.check-dot {
		flex: 0 0 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--blue);
		color: var(--white);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.dr-btn {
		align-self: flex-start;
		margin-top: 10px;
	}

	/* Why */
	.why {
		display: flex;
		flex-wrap: wrap;
		gap: 40px 64px;
	}
	.why-head {
		flex: 1 1 320px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.why-title {
		font-weight: 700;
		font-size: clamp(32px, 3.4vw, 44px);
		line-height: 1.15;
	}
	.why-btn {
		align-self: flex-start;
		margin-top: 12px;
		color: var(--navy);
	}
	.why-grid {
		flex: 2 1 560px;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
		gap: 32px 40px;
	}
	.why-item {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-top: 20px;
		border-top: 1px solid var(--navy-line);
	}
	.why-item h3 {
		font-size: 20px;
		font-weight: 700;
	}
	.why-item p {
		color: var(--on-dark-2);
		font-size: 16px;
	}

	.review-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 20px;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
		grid-auto-rows: 230px;
		gap: 16px;
	}
	.gallery :global(.tall) {
		grid-row: span 2;
	}

	/* Visit */
	.visit {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}
	.visit :global(.visit-map) {
		flex: 1.3 1 520px;
		min-width: 0;
	}
	.visit-card {
		flex: 1 1 380px;
		min-width: 0;
		border-radius: 18px;
		background: var(--soft);
		padding: clamp(28px, 4vw, 40px);
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.visit-title {
		font-weight: 700;
		font-size: 32px;
	}
	.visit-address {
		color: var(--body-2);
	}
	.visit-list {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 8px 24px;
	}
	.visit-list dt {
		color: var(--muted);
	}
	.visit-list dd {
		font-weight: 700;
	}
	.visit-list a {
		color: var(--ink);
		text-decoration: none;
	}
	.visit-btn {
		align-self: flex-start;
	}
</style>
