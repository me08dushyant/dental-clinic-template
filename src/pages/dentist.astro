---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { routes, site, treatmentHref } from '../data/site';
import { photos } from '../data/photos';
import { dentist } from '../data/dentist';
import { reviews } from '../data/reviews';

const stats = [
	{ value: dentist.years, label: 'Years in practice' },
	{ value: dentist.patients, label: 'Patients treated' },
	{ value: dentist.implants, label: 'Implants placed' },
	{ value: `${site.rating.value}★`, label: 'Google rating' },
];

const expertise = [
	{ icon: 'implant', title: 'Dental implants', text: 'Single teeth to full-arch restorations, planned on 3D scans.', slug: 'dental-implants' },
	{ icon: 'veneer', title: 'Smile design & veneers', text: 'Digitally previewed makeovers that still look like you.', slug: 'veneers' },
	{ icon: 'rootCanal', title: 'Painless root canals', text: 'Single-sitting rotary endodontics under a rubber dam.', slug: 'root-canal-treatment' },
	{ icon: 'aligners', title: 'Clear aligners', text: 'Certified aligner provider for mild to moderate crowding.', slug: 'clear-aligners' },
	{ icon: 'crown', title: 'Crowns & bridges', text: 'Metal-free zirconia and E-max, finished by hand.', slug: 'crowns-and-bridges' },
	{ icon: 'heart', title: 'Anxious patients', text: 'Unhurried visits, clear signals and breaks whenever you need.', slug: 'check-up-and-cleaning' },
] as const;

const drReviews = [reviews[0], reviews[5], reviews[2]];

const schema = [
	{
		'@type': 'Physician',
		name: dentist.name,
		jobTitle: dentist.role,
		medicalSpecialty: 'Dentistry',
		image: new URL(photos.dentistPortrait.src, Astro.site).href,
		description: dentist.intro,
		knowsLanguage: dentist.languages,
		hasCredential: dentist.degrees,
		memberOf: dentist.memberships.map((m) => ({ '@type': 'Organization', name: m })),
		worksFor: { '@id': new URL('/#clinic', Astro.site).href },
	},
];
---

<BaseLayout
	title={`${dentist.name}, ${dentist.degrees.split(' (')[0]} | ${site.name}, ${site.city}`}
	description={`Meet ${dentist.name}, ${dentist.role.toLowerCase()} at ${site.name}. ${dentist.degrees} with ${dentist.years} years' experience in implants, smile design and gentle family dentistry in ${site.area}.`}
	image={photos.dentistPortrait.src}
	imageAlt={`Portrait of ${dentist.name}`}
	type="article"
	crumbs={[{ label: 'Our Dentist' }]}
	schema={schema}
>
	<section aria-labelledby="page-title" class="profile">
		<Header tone="light" active="dentist" />
		<div class="container profile-grid">
			<div class="profile-copy">
				<nav aria-label="Breadcrumb" class="crumbs">
					<a href={routes.home}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Our Dentist</span>
				</nav>
				<p class="eyebrow">{dentist.role}</p>
				<h1 id="page-title" class="name">{dentist.name}</h1>
				<p class="quals">{dentist.degrees}</p>
				<p class="lead">{dentist.intro}</p>
				<ul class="chips">
					<li><Icon name="shield" size={16} strokeWidth={1.6} />{dentist.registration}</li>
					<li><Icon name="globe" size={16} strokeWidth={1.6} />{dentist.languages.join(' · ')}</li>
					<li><Icon name="heart" size={16} strokeWidth={1.6} />Great with nervous patients</li>
				</ul>
				<div class="btn-row">
					<a href={`${routes.contact}#book`} class="btn btn--lg btn--primary">Book with {dentist.shortName}</a>
					<a href={site.whatsapp} class="btn btn--lg btn--outline"><Icon name="whatsapp" size={18} strokeWidth={1.8} />WhatsApp</a>
				</div>
			</div>
			<div class="portrait">
				<span aria-hidden="true" class="portrait-arch"></span>
				<img src={photos.dentistPortrait.src} alt={`Portrait of ${dentist.name}`} fetchpriority="high" width="1000" height="1400" />
				<div class="portrait-card">
					<span class="portrait-icon"><Icon name="award" size={22} strokeWidth={1.5} /></span>
					<span><strong>Implantology Fellow</strong><span>Advanced training, 2016</span></span>
				</div>
			</div>
		</div>
		<div class="container">
			<dl class="stats">
				{
					stats.map((s) => (
						<div>
							<dt>{s.label}</dt>
							<dd>{s.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section aria-labelledby="bio-title" class="section">
		<div class="container split">
			<div class="bio">
				<p class="eyebrow">About {dentist.shortName}</p>
				<h2 id="bio-title" class="h2">Calm, precise and always honest about your options</h2>
				{dentist.bio.map((p) => <p class="muted">{p}</p>)}
				<a href={routes.about} class="text-link">About the clinic<Icon name="arrow" size={16} strokeWidth={2} /></a>
			</div>
			<div class="bio-media">
				<Photo label={`${dentist.name} walking a patient through an X-ray`} photo={photos.dentistXray} height="440px" radius="24px" />
				<Photo label={`${dentist.name} in the clinic`} photo={photos.dentistCasual} height="260px" radius="20px" position="center 15%" class="bio-inset" />
			</div>
		</div>
	</section>

	<section aria-labelledby="quote-title" class="section section--flush-top">
		<div class="container">
			<figure class="panel-dark quote">
				<h2 id="quote-title" class="eyebrow eyebrow--light">Philosophy of care</h2>
				<svg aria-hidden="true" width="44" height="32" viewBox="0 0 48 36" fill="currentColor" class="quote-mark"
					><path d="M0 36V20C0 9 6 2 18 0l2 5c-7 2-10 6-10 11h9v20H0zm27 0V20C27 9 33 2 45 0l2 5c-7 2-10 6-10 11h9v20H27z"></path></svg
				>
				<blockquote>{dentist.quote}</blockquote>
				<figcaption>
					<img src={photos.dentistPortrait.src} alt="" width="48" height="48" loading="lazy" />
					<span><strong>{dentist.name}</strong><span>{dentist.role}</span></span>
				</figcaption>
			</figure>
		</div>
	</section>

	<section aria-labelledby="edu-title" class="section bg-soft">
		<div class="container career-grid">
			<div class="section-head career-head">
				<p class="eyebrow">Qualifications</p>
				<h2 id="edu-title" class="h2">Education &amp; experience</h2>
				<p class="muted">Over a decade of focused training in restoring and replacing teeth, from hospital practice to founding {site.name}.</p>
			</div>
			<ol class="timeline">
				{
					dentist.career.map((c) => (
						<li>
							<span class="year">{c.year}</span>
							<h3>{c.title}</h3>
							<p>{c.where}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section aria-labelledby="focus-title" class="section">
		<div class="container stack">
			<div class="section-head section-head--center">
				<p class="eyebrow">Special interests</p>
				<h2 id="focus-title" class="h2">Areas of expertise</h2>
			</div>
			<div class="card-grid">
				{
					expertise.map((e) => (
						<a href={treatmentHref(e.slug)} class="skill">
							<span class="skill-icon">
								<Icon name={e.icon} size={26} strokeWidth={1.4} />
							</span>
							<h3>{e.title}</h3>
							<p>{e.text}</p>
							<span class="skill-more">
								Learn more<Icon name="arrow" size={14} strokeWidth={2} />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section aria-labelledby="member-title" class="section section--flush-top">
		<div class="container lists">
			<div class="list-card">
				<h2 id="member-title">Memberships</h2>
				<ul>{dentist.memberships.map((m) => <li>{m}</li>)}</ul>
			</div>
			<div class="list-card">
				<h2>Continuing education</h2>
				<ul>{dentist.education.map((e) => <li>{e}</li>)}</ul>
			</div>
		</div>
	</section>

	<section aria-labelledby="dr-rev-title" class="section bg-soft">
		<div class="container stack" style="--stack-gap: 40px">
			<div class="heading-row">
				<div class="section-head">
					<p class="eyebrow">In patients' words</p>
					<h2 id="dr-rev-title" class="h2">What patients say about {dentist.shortName}</h2>
				</div>
				<a href={routes.reviews} class="text-link">All reviews<Icon name="arrow" size={16} strokeWidth={2} /></a>
			</div>
			<div class="review-grid">
				{drReviews.map((r) => <ReviewCard review={r} />)}
			</div>
		</div>
	</section>

	<CtaBand
		title={`Meet ${dentist.shortName} in person`}
		text="Your first consultation includes a full check-up, a clear plan and a written estimate."
		primary={{ label: 'Book consultation', href: `${routes.contact}#book` }}
		secondary={{ label: 'WhatsApp us', href: site.whatsapp }}
	/>
</BaseLayout>

<style>
	/* Profile hero */
	.profile {
		background: var(--bg);
		padding-bottom: clamp(48px, 6vw, 80px);
	}
	.profile-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: 48px clamp(40px, 6vw, 96px);
		align-items: center;
		padding-block: clamp(40px, 5vw, 72px) 48px;
	}
	.profile-copy {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.crumbs {
		display: flex;
		gap: 8px;
		font-size: 13px;
		color: var(--muted);
	}
	.crumbs a {
		color: var(--body-2);
	}
	.name {
		font-weight: 500;
		font-size: clamp(44px, 6vw, 80px);
		line-height: 1;
		letter-spacing: -0.04em;
	}
	.quals {
		font-family: var(--font-display);
		font-size: 19px;
		color: var(--accent);
	}
	.lead {
		color: var(--body-2);
		font-size: 17px;
		max-width: 34em;
	}
	.chips {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chips li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		border-radius: 999px;
		background: var(--white);
		border: 1px solid var(--line-2);
		font-size: 13px;
		font-weight: 500;
	}
	.chips :global(svg) {
		color: var(--accent);
	}
	.profile-copy .btn-row {
		margin-top: 8px;
	}
	.portrait {
		position: relative;
		justify-self: center;
		width: min(100%, 460px);
		aspect-ratio: 5 / 7;
	}
	.portrait-arch {
		position: absolute;
		inset: 8% -6% 0;
		border-radius: 999px 999px 32px 32px;
		background: var(--soft);
	}
	.portrait img {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
		border-radius: 999px 999px 28px 28px;
		display: block;
	}
	.portrait-card {
		position: absolute;
		left: -32px;
		bottom: 48px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 20px 14px 14px;
		border-radius: 18px;
		background: var(--white);
		box-shadow: var(--shadow-card);
		line-height: 1.3;
	}
	.portrait-card > span:last-child {
		display: flex;
		flex-direction: column;
	}
	.portrait-card strong {
		font-size: 15px;
		font-weight: 600;
	}
	.portrait-card > span:last-child > span {
		font-size: 13px;
		color: var(--muted);
	}
	.portrait-icon {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--tint);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
		border-radius: 24px;
		background: var(--white);
		border: 1px solid var(--line-2);
	}
	.stats > div {
		padding: 28px;
		display: flex;
		flex-direction: column-reverse;
		gap: 4px;
		border-left: 1px solid var(--line-2);
	}
	.stats > div:first-child {
		border-left: 0;
	}
	.stats dd {
		font-family: var(--font-display);
		font-size: clamp(30px, 3vw, 40px);
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.stats dt {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	/* Bio */
	.bio {
		flex: 1 1 460px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.bio .text-link {
		align-self: flex-start;
	}
	.bio-media {
		flex: 1 1 420px;
		position: relative;
		padding-bottom: 120px;
	}
	.bio-media :global(.bio-inset) {
		position: absolute;
		right: -12px;
		bottom: 0;
		width: 46%;
		border: 6px solid var(--bg);
		box-shadow: var(--shadow-card);
	}

	/* Quote */
	.quote {
		padding: clamp(40px, 6vw, 88px);
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.quote-mark {
		color: var(--accent-light);
	}
	.quote blockquote {
		font-family: var(--font-display);
		font-size: clamp(24px, 2.8vw, 38px);
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: -0.015em;
		max-width: 28em;
	}
	.quote figcaption {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.quote figcaption img {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 20%;
	}
	.quote figcaption > span {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.quote figcaption > span > span {
		font-size: 14px;
		color: var(--on-dark-2);
	}

	/* Career */
	.career-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: 40px clamp(40px, 6vw, 96px);
		align-items: start;
	}
	.career-head {
		position: sticky;
		top: 112px;
	}
	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
	}
	.timeline li {
		position: relative;
		padding: 0 0 36px 36px;
		border-left: 1px solid var(--line);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.timeline li:last-child {
		padding-bottom: 0;
		border-left-color: transparent;
	}
	.timeline li::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 4px;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent-soft);
	}
	.timeline li:last-child::before {
		background: var(--primary);
		border-color: var(--primary);
	}
	.year {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--accent);
	}
	.timeline h3 {
		font-size: 21px;
		font-weight: 500;
	}
	.timeline p {
		color: var(--muted);
		font-size: 15px;
	}

	/* Expertise */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 20px;
	}
	.skill {
		padding: 28px;
		border-radius: 22px;
		background: var(--white);
		border: 1px solid var(--line-2);
		color: var(--ink);
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.skill:hover {
		color: var(--ink);
		transform: translateY(-3px);
		box-shadow: var(--shadow-card);
	}
	.skill-icon {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: var(--tint);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 6px;
	}
	.skill h3 {
		font-size: 20px;
		font-weight: 500;
	}
	.skill p {
		color: var(--muted);
		font-size: 15px;
	}
	.skill-more {
		margin-top: auto;
		padding-top: 6px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--accent);
		font-size: 14px;
		font-weight: 600;
	}

	/* Lists */
	.lists {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 20px;
	}
	.list-card {
		padding: 36px;
		border-radius: 22px;
		background: var(--white);
		border: 1px solid var(--line-2);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.list-card h2 {
		font-size: 24px;
		font-weight: 500;
	}
	.list-card ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 12px;
		color: var(--body-2);
	}
	.list-card li {
		display: flex;
		gap: 12px;
	}
	.list-card li::before {
		content: '';
		flex: none;
		width: 6px;
		height: 6px;
		margin-top: 10px;
		border-radius: 50%;
		background: var(--accent-soft);
	}

	.review-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 20px;
	}

	@media (max-width: 900px) {
		.profile-grid,
		.career-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.portrait {
			order: -1;
			width: min(100%, 380px);
		}
		.career-head {
			position: static;
		}
	}
	@media (max-width: 560px) {
		.portrait {
			width: min(78%, 300px);
		}
		.portrait-card {
			left: -12%;
			bottom: 20px;
			padding: 10px 16px 10px 10px;
		}
		.portrait-icon {
			width: 36px;
			height: 36px;
		}
		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.stats > div {
			padding: 20px;
		}
		.stats > div:nth-child(3) {
			border-left: 0;
		}
		.stats > div:nth-child(n + 3) {
			border-top: 1px solid var(--line-2);
		}
		.bio-media {
			padding-bottom: 90px;
		}
	}
</style>
