---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { bookFor, routes, site } from '../../data/site';
import { photos } from '../../data/photos';

const included = [
	{ title: 'Check-ups & exams', time: '[30 min]', text: 'A full check of teeth, gums and bite, with digital X-rays when needed and a clear summary.' },
	{ title: 'Scaling & polishing', time: '[45 min]', text: 'Ultrasonic cleaning removes tartar, then a polish lifts tea, coffee and tobacco stains.' },
	{ title: "Children's dentistry", time: '[20 min]', text: 'Short, playful visits that build trust, check growth and teach good habits.', featured: true },
	{ title: 'Tooth-coloured fillings', time: '[45 min]', text: 'Composite fillings matched to your shade, keeping as much natural tooth as possible.' },
	{ title: 'Preventive care', time: '[20 min]', text: 'Fluoride varnish, sealants and personal brushing advice to stop decay early.' },
	{ title: 'Gum treatment', time: '[60 min]', text: 'Deep cleaning for bleeding or receding gums, with follow-up to keep them healthy.' },
];

const schedule = [
	{ when: '6 mo', what: 'Check-up', note: 'For most adults and kids' },
	{ when: '6–12 mo', what: 'Cleaning', note: 'More often if gums bleed' },
	{ when: 'Age 1', what: 'First visit', note: 'Or at the first tooth', dark: true },
	{ when: 'Age 6–12', what: 'Sealants', note: 'As molars come in' },
];

const faqs = [
	{ q: 'Does cleaning damage enamel?', a: 'No. Scaling removes hardened deposits, not enamel. Mild sensitivity for a day is normal.' },
	{ q: 'How long do fillings last?', a: 'With good care, many years. We check them at every visit.' },
	{ q: 'What does a check-up cost?', a: '[Consultation fee ₹[amount]. Add your pricing note here.]' },
	{ q: 'Can my whole family come together?', a: 'Yes. Ask for back-to-back family slots when you book.' },
];
---

<BaseLayout title={`General Dentistry — ${site.name}`}>
	<PageHero
		title="General Dentistry"
		lead="Check-ups, cleaning and fillings. The everyday care that keeps small problems small."
		photo={photos.heroGeneral}
		active="services"
		crumbs={[{ label: 'Treatments', href: routes.services }, { label: 'General' }]}
		wideTitle
	>
		<div class="btn-row hero-btns">
			<a href={bookFor('check-up')} class="btn btn--blue">Book a check-up</a>
			<a href={site.whatsapp} class="btn btn--outline-white">WhatsApp us</a>
		</div>
	</PageHero>

	<section aria-labelledby="inc-title" class="section">
		<div class="container stack">
			<div class="section-head section-head--center">
				<p class="eyebrow">What's included</p>
				<h2 id="inc-title" class="h2">Everyday Care for All Ages</h2>
			</div>
			<div class="included">
				{
					included.map((item) => (
						<article class:list={{ featured: item.featured }}>
							<div class="item-head">
								<h3>{item.title}</h3>
								<span class="pill">{item.time}</span>
							</div>
							<p>{item.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section aria-labelledby="sched-title" class="section bg-soft">
		<div class="container split">
			<div class="sched-copy">
				<p class="eyebrow">A simple routine</p>
				<h2 id="sched-title" class="h2">How Often Should Your Family Visit?</h2>
				<p class="muted">Regular visits catch problems while they're quick and inexpensive to fix.</p>
			</div>
			<div class="schedule">
				{
					schedule.map((s) => (
						<div class:list={['sched', { dark: s.dark }]}>
							<span class="sched-when">{s.when}</span>
							<strong>{s.what}</strong>
							<span class="sched-note">{s.note}</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section aria-labelledby="faq-title" class="section">
		<div class="container container--narrow stack" style="--stack-gap: 40px">
			<div class="section-head section-head--center">
				<p class="eyebrow">FAQ</p>
				<h2 id="faq-title" class="h2">Common Questions</h2>
			</div>
			<FaqList items={faqs} />
		</div>
	</section>

	<CtaBand
		title="Due for a check-up?"
		text="Book in under a minute, online or on WhatsApp."
		primary={{ label: 'Book a check-up', href: bookFor('check-up') }}
		secondary={{ label: 'All treatments', href: routes.services }}
	/>
</BaseLayout>

<style>
	.hero-btns {
		gap: 14px;
		margin-top: 8px;
	}

	.included {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
		gap: 20px;
	}
	.included article {
		padding: 32px;
		border: 1px solid var(--line);
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.item-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
	}
	.item-head h3 {
		font-size: 22px;
		font-weight: 700;
	}
	.item-head .pill {
		align-self: center;
		white-space: nowrap;
	}
	.included p {
		color: var(--muted);
	}
	.included article.featured {
		background: var(--blue);
		border-color: var(--blue);
		color: var(--white);
		box-shadow: var(--shadow-blue);
	}
	.included article.featured .pill {
		background: var(--white);
	}
	.included article.featured p {
		color: var(--on-blue);
	}

	.sched-copy {
		flex: 1 1 360px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.schedule {
		flex: 1.3 1 520px;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.sched {
		padding: 28px;
		border-radius: 16px;
		background: var(--white);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.sched-when {
		font-size: 36px;
		font-weight: 800;
		color: var(--blue);
		line-height: 1.1;
	}
	.sched-note {
		color: var(--muted);
		font-size: 15px;
	}
	.sched.dark {
		background: var(--navy);
		color: var(--white);
	}
	.sched.dark .sched-when {
		color: var(--accent-light);
	}
	.sched.dark .sched-note {
		color: var(--on-dark-2);
	}
	@media (max-width: 480px) {
		.sched {
			padding: 20px;
		}
		.sched-when {
			font-size: 28px;
		}
	}
</style>
